# ─── App ─────────────────────────────────────────────────────────────
PORT=3000
APP_BASE_URL=https://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string
NODE_ENV=development
# Set to "true" once you're running behind real TLS (see README "Going to HTTPS")
TRUST_PROXY=false

# ─── Which SSO protocol to use for the "Log in" button ────────────────
# One of: saml | oidc
DEFAULT_PROTOCOL=saml

# ─── SAML (PingFederate as IdP) ────────────────────────────────────────
# PingFederate IdP metadata / SSO endpoint, e.g. https://localhost:9031/idp/SSO.saml2
SAML_IDP_SSO_URL=https://localhost:9031/idp/SSO.saml2
# PingFederate SLO endpoint, e.g. https://localhost:9031/idp/SLO.saml2
SAML_IDP_SLO_URL=https://localhost:9031/idp/SLO.saml2
# Entity ID you configured for PingFederate's IdP role (Server Settings > Federation Info)
SAML_IDP_ISSUER=https://localhost:9031
# Entity ID you gave THIS app when creating the SP Connection in PingFederate
SAML_SP_ISSUER=urn:cascade:internal-portal
# Path to the PingFederate signing certificate you exported (see README)
SAML_IDP_CERT_PATH=./certs/pingfederate-idp-signing.pem
# This app's own keypair, used to sign SP-initiated AuthnRequests (optional but recommended)
SAML_SP_PRIVATE_KEY_PATH=./certs/sp-private-key.pem
SAML_SP_CERT_PATH=./certs/sp-cert.pem
SAML_CALLBACK_PATH=/auth/saml/callback

# ─── OIDC (PingFederate as OP) ──────────────────────────────────────────
OIDC_ISSUER_URL=https://localhost:9031
OIDC_AUTHORIZATION_URL=https://localhost:9031/as/authorization.oauth2
OIDC_TOKEN_URL=https://localhost:9031/as/token.oauth2
OIDC_USERINFO_URL=https://localhost:9031/idp/userinfo.openid
OIDC_END_SESSION_URL=https://localhost:9031/idp/startSLO.ping
OIDC_CLIENT_ID=cascade-internal-portal
OIDC_CLIENT_SECRET=replace-with-the-secret-pingfederate-generated
OIDC_CALLBACK_PATH=/auth/oidc/callback
OIDC_SCOPE=openid profile email

# ─── Local break-glass login (bypasses PingFederate, see README) ──────
# Off by default — this is a fallback, not a second real login system.
LOCAL_LOGIN_ENABLED=false
LOCAL_ADMIN_EMAIL=admin@cascade.local
# Generate with: node scripts/hash-password.js "your-password-here"
LOCAL_ADMIN_PASSWORD_HASH=
LOCAL_ADMIN_DISPLAY_NAME=Local Admin
LOCAL_ADMIN_GROUPS=admin

# ─── MFA (app-level TOTP step-up, see README "About the MFA design") ──
MFA_ISSUER_NAME=Cascade Internal Portal

# ─── TLS (self-signed, for local HTTPS — see README) ───────────────────
TLS_KEY_PATH=./certs/server-key.pem
TLS_CERT_PATH=./certs/server-cert.pem
